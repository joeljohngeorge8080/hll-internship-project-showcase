# Copy this file to .env and set your local values.
# .env is git-ignored; .env.example is committed as documentation.

# FastAPI backend base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Supabase project (hma-iems) - anon/public key only, never the service_role key
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Google OAuth Client ID (from Google Cloud Console > APIs & Services > Credentials)
VITE_GOOGLE_CLIENT_ID=

# Set to 'true' to bypass login in local dev mode (never set true in production)
VITE_DEV_LOGIN=false
